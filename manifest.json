{
  "manifest_version": 3,
  "name": "QuotaLens",
  "version": "0.1.1",
  "description": "See Claude, Codex and Gemini 5-hour and weekly usage above your chat input. Clear quota bars, reset timers, no API key.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://*.claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*"
  ],
  "action": {
    "default_title": "QuotaLens — Your AI quota, in focus.",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "src/gemini-main.bundle.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://claude.ai/*",
        "https://*.claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "src/providers.js",
        "src/gemini-rpc.js",
        "src/gemini-usage.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "version_name": "0.1.1",
  "minimum_chrome_version": "111",
  "homepage_url": "https://github.com/zhidacaishu/QuotaLens"
}
